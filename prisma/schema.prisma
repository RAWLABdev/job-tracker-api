generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum JobSource {
  LINKEDIN
  GETONBRD
  TRABAJANDO
  REFERRED
  OTHER
}

enum JobStatus {
  APPLIED
  INTERVIEW
  TECHNICAL
  OFFER
  REJECTED
}

model JobApplication {
  id           String    @id @default(uuid())
  company      String
  position     String
  source       JobSource @default(OTHER)
  status       JobStatus @default(APPLIED)
  salaryRange  String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
